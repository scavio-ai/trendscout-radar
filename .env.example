# Copy to .env (or export these) for local runs. Never commit real values.

# Unlocks TikTok, YouTube, Reddit and X. Without it, free sources only.
SCAVIO_API_KEY=

# Optional AI briefing, any OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Optional delivery channels: set the ones you want.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
